# ============================================================
# DOSTONBEK AI BOT — Environment Variables Template
# Nusxalab .env yarating. Hech qachon .env faylni GitHub'ga yuklamang!
# ============================================================

# 1. Telegram Bot API (@BotFather dan)
BOT_TOKEN=your_telegram_bot_token_here

# 2. Xavfsizlik: Faqat shu Telegram ID egasi botni boshqara oladi
ALLOWED_TELEGRAM_ID=123456789

# 3. Google Gemini API (Google AI Studio dan)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 4. PostgreSQL (Render avtomatik ulaydi; lokal test uchun SQLite ishlaydi)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dostonbek_ai_bot

# 5. MTProto 1:1 VoIP Qo'ng'iroqlar (@D_admin_aka -> @d0stonbek)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
# Lokal kompyuterda: python scripts/generate_session.py orqali yarating
TELEGRAM_SESSION_STRING=
CALLER_USERNAME=@D_admin_aka
CALLEE_USERNAME=@d0stonbek

# 6. Vaqt zonasi va o'zbekcha ovoz
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_VOICE_NAME=uz-UZ-SardorNeural
DEFAULT_VOICE_RATE=+0%
AUDIO_OUTPUT_DIR=/tmp/dostonbek_audio

# 7. Render Web Service & Webhook sozlamalari
ENABLE_HEALTH_SERVER=true
USE_WEBHOOK=false
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=replace_with_random_secret
PORT=10000
LOG_LEVEL=INFO
